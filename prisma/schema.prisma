generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model animal {
  animal_id     Int           @id @default(autoincrement())
  name          String        @db.VarChar(50)
  sex           String        @db.Char(1)
  date_of_birth DateTime      @db.Date
  species       String        @db.VarChar(50)
  race          String        @db.VarChar(50)
  weight_kg     Int
  color         String        @db.VarChar(50)
  sterilizes    Boolean
  chip_number   Int
  photo         String        @db.VarChar(255)
  owner_id      Int
  user          user          @relation(fields: [owner_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  user_animal   user_animal[]
}

model treatment {
  treatment_id    Int               @id @default(autoincrement())
  name            String            @db.VarChar(50)
  date_start      DateTime          @db.Date
  date_end        DateTime          @db.Date
  reason          String
  comments        String
  treatment_visit treatment_visit[]
  visit           visit[]
}

model treatment_visit {
  treatment_visit_id Int       @id @default(autoincrement())
  visit_id           Int
  treatment_id       Int
  treatment          treatment @relation(fields: [treatment_id], references: [treatment_id], onDelete: Cascade, onUpdate: NoAction)
  visit              visit     @relation(fields: [visit_id], references: [visit_id], onDelete: Cascade, onUpdate: NoAction)
}

model user {
  user_id                           Int           @id @default(autoincrement())
  uuid                              String?       @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                              String        @db.VarChar(50)
  first_name                        String        @db.VarChar(50)
  phone                             String?       @db.VarChar(20)
  email                             String        @unique @db.VarChar(100)
  password                          String        @db.VarChar(255)
  address                           String?       @db.VarChar(255)
  role                              String        @db.VarChar(100)
  created_at                        DateTime?     @default(now()) @db.Timestamp(6)
  animal                            animal[]
  user_animal                       user_animal[]
  visit_visit_medical_team_idTouser visit[]       @relation("visit_medical_team_idTouser")
  visit_visit_user_idTouser         visit[]       @relation("visit_user_idTouser")
}

model user_animal {
  user_animal_id Int    @id @default(autoincrement())
  user_id        Int
  animal_id      Int
  animal         animal @relation(fields: [animal_id], references: [animal_id], onDelete: Cascade, onUpdate: NoAction)
  user           user   @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model visit {
  visit_id                         Int               @id @default(autoincrement())
  user_id                          Int
  date                             DateTime          @db.Timestamp(6)
  reason                           String            @db.VarChar(200)
  comments                         String
  diagnosis                        String?
  medical_team_id                  Int
  treatment_id                     Int
  treatment_visit                  treatment_visit[]
  user_visit_medical_team_idTouser user              @relation("visit_medical_team_idTouser", fields: [medical_team_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  treatment                        treatment         @relation(fields: [treatment_id], references: [treatment_id], onDelete: Cascade, onUpdate: NoAction)
  user_visit_user_idTouser         user              @relation("visit_user_idTouser", fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}
