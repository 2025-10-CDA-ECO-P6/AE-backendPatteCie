generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TreatmentVisit {
  treatment_visit_id Int @id @default(autoincrement())
  visit_id           Int
  treatment_id       Int
}

model User {
  user_id        Int         @id @default(autoincrement())
  uuid           String?     @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String      @db.VarChar(50)
  first_name     String      @db.VarChar(50)
  phone          String?     @db.VarChar(20)
  email          String      @unique @db.VarChar(100)
  password       String      @db.VarChar(255)
  address        String?     @db.VarChar(255)
  role           String      @db.VarChar(100)
  created_at     DateTime?   @default(now()) @db.Timestamp(6)
  ownerVisits    Visit[]     @relation("ownerVisits")
  vetVisits      Visit[]     @relation("vetVisits")
  treatedAnimals Animal[]    @relation("VeterinarianAnimals")
  myAnimals      Animal[]    @relation("UserAnimals")
  visitUsers     VisitUser[]
}

model Visit {
  visit_id  Int      @id @default(autoincrement())
  date      DateTime @db.Timestamp(6)
  reason    String   @db.VarChar(200)
  comments  String
  diagnosis String?

  vaterinarian_id       Int
  veterinarian          User?       @relation("vetVisits", fields: [vaterinarian_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  owner_id              Int
  owner                 User?       @relation("ownerVisits", fields: [owner_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  treatment_id          Int
  treatment             Treatment?  @relation(fields: [treatmentTreatment_id], references: [treatment_id])
  treatmentTreatment_id Int?
  visitUsers            VisitUser[]
}

model Treatment {
  treatment_id Int      @id @default(autoincrement())
  name         String   @db.VarChar(50)
  date_start   DateTime @db.Date
  date_end     DateTime @db.Date
  reason       String
  comments     String
  visits       Visit[]
}

model Animal {
  animal_id     Int      @id @default(autoincrement())
  name          String   @db.VarChar(50)
  sex           String   @db.Char(1)
  date_of_birth DateTime @db.Date
  species       String   @db.VarChar(50)
  race          String   @db.VarChar(50)
  weight_kg     Int
  color         String   @db.VarChar(50)
  sterilizes    Boolean
  chip_number   Int
  photo         String   @db.VarChar(255)
  owner_id      Int
  owner         User[]   @relation("UserAnimals")
  veterinarians User[]   @relation("VeterinarianAnimals")
}

model VisitUser {
  visit_id Int
  user_id  Int

  visit Visit? @relation(fields: [visit_id], references: [visit_id])
  user  User?  @relation(fields: [user_id], references: [user_id])

  @@id([visit_id, user_id])
}
