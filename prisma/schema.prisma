// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Owner {
  owner_id   Int      @id @default(autoincrement())
  UUID       Int
  name       String   @db.VarChar(50)
  first_name String   @db.VarChar(50)
  phone      Int
  email      String   @db.VarChar(100)
  adress     String   @db.VarChar(255)
  
  animals    Animal[]

  @@map("owner")
}

model Animal {
  animal_id    Int      @id @default(autoincrement())
  name         String   @db.VarChar(50)
  sex          String   @db.Char(1)
  date_of_birth DateTime @db.Date
  species      String   @db.VarChar(50)
  race         String   @db.VarChar(50)
  weight_kg    Int
  color        String   @db.VarChar(50)
  sterilizes   Boolean
  chip_number  Int
  photo        String   @db.VarChar(255)
  owner_id     Int
  
  owner        Owner    @relation(fields: [owner_id], references: [owner_id])
  visits       Visit[]

  @@map("animal")
}

model Visit {
  visit_id          Int       @id @default(autoincrement())
  date              DateTime
  reason            String    @db.VarChar(200)
  comments          String    @db.Text
  animal_id         Int
  medical_team_id   Int
  treatment_id      Int
  
  animal            Animal         @relation(fields: [animal_id], references: [animal_id])
  medical_team      MedicalTeam    @relation(fields: [medical_team_id], references: [medical_team_id])
  treatment         Treatment      @relation(fields: [treatment_id], references: [treatment_id])
  treatmentVisits          TreatmentVisit[]

  @@map("visit")
}

model Treatment {
  treatment_id Int       @id @default(autoincrement())
  name         String    @db.VarChar(50)
  date_start   DateTime  @db.Date
  date_end     DateTime  @db.Date
  reason       String    @db.Text
  comments     String    @db.Text
  
  visits       Visit[]
  treatmentVisits     TreatmentVisit[]

  @@map("treatment")
}

model MedicalTeam {
  medical_team_id Int      @id @default(autoincrement())
  UUID            Int
  name            String   @db.VarChar(50)
  first_name      String   @db.VarChar(50)
  email           String   @db.VarChar(100)
  phone           Int
  role            String   @db.VarChar(100)
  
  visits          Visit[]

  @@map("medical_team")
}

model TreatmentVisit {
  include_id   Int @id @default(autoincrement())
  visit_id     Int
  treatment_id Int
  
  visit        Visit     @relation(fields: [visit_id], references: [visit_id])
  treatment    Treatment @relation(fields: [treatment_id], references: [treatment_id])

  @@map("treatmentVisite")
}