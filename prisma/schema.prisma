generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id       Int          @id @default(autoincrement())
  name          String
  first_name    String
  email         String       @unique
  phone         String?
  password      String
  address       String?
  role          String
  animals       Animal[]     @relation("OwnedAnimals")
  userAnimals   UserAnimal[]
  medicalVisits Visit[]      @relation("MedicalVisits")
  visits        Visit[]      @relation("OwnerVisits")
}

model Animal {
  animal_id     Int              @id @default(autoincrement())
  name          String
  sex           String
  date_of_birth DateTime
  species       String
  race          String
  weight_kg     Float
  color         String
  sterilizes    Boolean
  chip_number   Int
  photo         String?
  owner_id      Int
  owner         User             @relation("OwnedAnimals", fields: [owner_id], references: [user_id])
  treatments    TreatmentVisit[]
  users         UserAnimal[]
}

model UserAnimal {
  id        Int    @id @default(autoincrement())
  user_id   Int
  animal_id Int
  animal    Animal @relation(fields: [animal_id], references: [animal_id])
  user      User   @relation(fields: [user_id], references: [user_id])

  @@unique([user_id, animal_id])
}

model Treatment {
  treatment_id Int              @id @default(autoincrement())
  name         String
  date_start   DateTime
  date_end     DateTime
  reason       String
  comments     String?
  visits       TreatmentVisit[]
}

model Visit {
  visit_id        Int              @id @default(autoincrement())
  user_id         Int
  medical_team_id Int
  date            DateTime
  reason          String
  comments        String?
  diagnosis       String?
  treatments      TreatmentVisit[]
  medicalTeam     User             @relation("MedicalVisits", fields: [medical_team_id], references: [user_id])
  user            User             @relation("OwnerVisits", fields: [user_id], references: [user_id])
}

model TreatmentVisit {
  id              Int       @id @default(autoincrement())
  treatment_id    Int
  visit_id        Int
  animalAnimal_id Int?
  animal          Animal?   @relation(fields: [animalAnimal_id], references: [animal_id])
  treatment       Treatment @relation(fields: [treatment_id], references: [treatment_id])
  visit           Visit     @relation(fields: [visit_id], references: [visit_id])

  @@unique([treatment_id, visit_id])
}
