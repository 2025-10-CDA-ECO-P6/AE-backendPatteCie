generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id    Int       @id @default(autoincrement())
  uuid       String?   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String    @db.VarChar(50)
  first_name String    @db.VarChar(50)
  phone      String?   @db.VarChar(20)
  email      String    @unique @db.VarChar(100)
  password   String    @db.VarChar(255)
  address    String?   @db.VarChar(255)
  role       String    @db.VarChar(100)
  created_at DateTime? @default(now()) @db.Timestamp(6)

  animals Animal[]
}

model Animal {
  animal_id     Int      @id @default(autoincrement())
  name          String   @db.VarChar(50)
  sex           String   @db.Char(1)
  date_of_birth DateTime @db.Date
  species       String   @db.VarChar(50)
  race          String   @db.VarChar(50)
  weight_kg     Int
  color         String   @db.VarChar(50)
  sterilizes    Boolean
  chip_number   Int
  photo         String?  @db.VarChar(255)

  owner_id Int
  owner    User @relation(fields: [owner_id], references: [user_id], onDelete: Cascade)

  visits Visit[]
}

model Visit {
  visit_id  Int      @id @default(autoincrement())
  date      DateTime @db.Timestamp(6)
  reason    String   @db.VarChar(200)
  comments  String
  diagnosis String?

  animal_id Int
  animal    Animal @relation(fields: [animal_id], references: [animal_id], onDelete: Cascade)

  treatments Treatment[]
  vaccines   Vaccine[]
}

model Treatment {
  treatment_id Int      @id @default(autoincrement())
  name         String   @db.VarChar(50)
  date_start   DateTime @db.Date
  date_end     DateTime @db.Date
  reason       String
  comments     String

  visit_id Int
  visit    Visit @relation(fields: [visit_id], references: [visit_id], onDelete: Cascade)
}

model Vaccine {
  vaccine_id Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  date       DateTime @db.Date
  notes      String?  @db.VarChar(255)

  visit_id Int
  visit    Visit @relation(fields: [visit_id], references: [visit_id], onDelete: Cascade)
}